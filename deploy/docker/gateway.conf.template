upstream mu56_django { server 127.0.0.1:8000; }
upstream mu56_next { server 127.0.0.1:3000; }
log_format mu56_safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
limit_req_zone $binary_remote_addr zone=mu56_leads:10m rate=10r/m;
server {
    listen 8080;
    server_name ${SITE_HOST};
    if ($host != ${SITE_HOST}) { return 444; }
    client_max_body_size 32m;
    set_real_ip_from 172.30.56.1;
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    access_log /var/log/nginx/access.log mu56_safe;
    proxy_http_version 1.1;
    proxy_set_header Host ${SITE_HOST};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_redirect off;
    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript image/svg+xml;
    location = /api/v1/leads/ {
        gzip off;
        client_max_body_size 64k;
        limit_req zone=mu56_leads burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://mu56_django;
    }
    location /api/ { gzip off; client_max_body_size 64k; proxy_pass http://mu56_django; }
    location = /admin { return 308 /admin/; }
    location /admin/ { gzip off; proxy_pass http://mu56_django; }
    location /static/ { alias /srv/mu56/shared/static/; autoindex off; }
    location /uploads/ { alias /srv/mu56/shared/media/; autoindex off; }
    location /_next/static/ {
        proxy_hide_header Cache-Control;
        add_header Cache-Control 'public, max-age=31536000, immutable';
        proxy_pass http://mu56_next;
    }
    location / { proxy_buffering off; proxy_pass http://mu56_next; }
}
server {
    listen 127.0.0.1:8081;
    access_log off;
    location /api/v1/ {
        limit_except GET { deny all; }
        proxy_set_header Host ${SITE_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For 127.0.0.1;
        proxy_pass http://mu56_django;
    }
    location /uploads/ { alias /srv/mu56/shared/media/; autoindex off; }
    location / { return 404; }
}
