log_format mu56_edge '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name dev.mu56.ru;
    if ($host != dev.mu56.ru) { return 444; }
    ssl_certificate /etc/letsencrypt/live/dev.mu56.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dev.mu56.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    allow ALLOWED_IP;
    allow 127.0.0.1;
    allow ::1;
    deny all;
    add_header X-Robots-Tag 'noindex, nofollow' always;
    access_log /var/log/nginx/mu56-dev-access.log mu56_edge;
    client_max_body_size 32m;
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host dev.mu56.ru;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_redirect off;
        proxy_buffering off;
    }
}
