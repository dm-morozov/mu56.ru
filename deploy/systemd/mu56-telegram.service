[Unit]
Description=Mir Ulybok Telegram notification queue
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=mu56
Group=mu56
WorkingDirectory=/srv/mu56/current/backend
EnvironmentFile=/etc/mu56/django.env
ExecStart=/srv/mu56/current/.venv/bin/python manage.py telegram_worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/mu56/shared/private-cache

[Install]
WantedBy=multi-user.target

