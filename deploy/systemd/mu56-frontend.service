[Unit]
Description=Mir Ulybok Next.js website
After=network.target nginx.service mu56-backend.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=mu56
Group=mu56
WorkingDirectory=/srv/mu56/current/frontend
EnvironmentFile=/etc/mu56/frontend.env
ExecStart=/usr/bin/node /srv/mu56/current/frontend/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/mu56/shared/next-cache

[Install]
WantedBy=multi-user.target

