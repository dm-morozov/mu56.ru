[Unit]
Description=Mir Ulybok Django API and admin
After=network.target postgresql.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=mu56
Group=mu56
WorkingDirectory=/srv/mu56/current/backend
EnvironmentFile=/etc/mu56/django.env
ExecStart=/srv/mu56/current/.venv/bin/gunicorn --config /srv/mu56/current/deploy/gunicorn.conf.py config.wsgi:application
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/mu56/shared/media /srv/mu56/shared/private-cache

[Install]
WantedBy=multi-user.target

