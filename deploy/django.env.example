# Copy to /etc/mu56/django.env. Root-owned, mode 0600; never commit filled values.
DJANGO_SETTINGS_MODULE=config.production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=mu56.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://mu56.ru
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=mu56
PGUSER=mu56
PGPASSWORD=
DJANGO_STATIC_ROOT=/srv/mu56/shared/static
DJANGO_MEDIA_ROOT=/srv/mu56/shared/media
DJANGO_CACHE_ROOT=/srv/mu56/shared/private-cache
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

